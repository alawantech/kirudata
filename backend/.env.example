# ============================================================
# Copy this to .env and fill in your values
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=production

# --- PostgreSQL (Prisma) ---
# connection_limit=20  → allow up to 20 concurrent DB connections
# pool_timeout=10      → fail fast (10 s) if all connections are busy
# Local:   postgresql://postgres:password@localhost:5432/guchor_data
# VPS:     postgresql://USER:PASS@HOST:5432/DB_NAME
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/guchor_data?schema=public&connection_limit=20&pool_timeout=10"

# --- JWT ---
# Must match your cookie maxAge. Use 30m for web, or 7d if mobile app needs
# long-lived tokens (both share the same signToken function).
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars_here
JWT_EXPIRES_IN=30m

# --- Cookie ---
COOKIE_SECRET=another_long_random_secret_for_cookies

# --- Frontend URL (for CORS) ---
FRONTEND_URL=https://yourdomain.com
